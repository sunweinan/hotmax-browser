{
  "name": "hotmax-browser",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "main": "src/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron src/main.cjs",
    "browser": "node bin/hotmax-browser.js",
    "test": "node --test test/*.test.js",
    "test:browser": "node test/integration.js",
    "check": "prettier --check src bin scripts test examples package.json .github",
    "format": "prettier --write src bin scripts test examples package.json .github",
    "package": "node scripts/package.mjs",
    "release:source": "node scripts/release-source.mjs"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "45.3.2",
    "prettier": "^3.9.10"
  },
  "productName": "Hotmax Browser",
  "description": "开源 AI 浏览器与浏览器自动化工具，面向 Codex、AI Agent 和 AI 编程助手。通过 CLI、JavaScript、DOM 实现浏览器控制、网页交互、数据提取、自动填表和工作流自动化，不占用系统鼠标。Open-source AI browser, browser automation, browser control, AI assistant tools, web scraping, form automation and workflow automation. macOS / Windows.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunweinan/hotmax-browser.git"
  },
  "bugs": {
    "url": "https://github.com/sunweinan/hotmax-browser/issues"
  },
  "homepage": "https://github.com/sunweinan/hotmax-browser#readme",
  "bin": {
    "hotmax-browser": "bin/hotmax-browser.js"
  },
  "keywords": [
    "browser",
    "electron",
    "cli",
    "automation",
    "javascript",
    "ai-agent",
    "macos",
    "windows",
    "ai-browser",
    "browser-automation",
    "web-automation",
    "ai-agents",
    "codex",
    "dom",
    "web-scraping",
    "form-automation",
    "浏览器",
    "AI浏览器",
    "浏览器自动化",
    "网页自动操作",
    "ai-assistant",
    "browser-control",
    "workflow-automation",
    "developer-tools",
    "coding-assistant",
    "agent-tools",
    "data-extraction",
    "desktop-browser",
    "AI编程助手",
    "命令行浏览器",
    "网页交互",
    "网页数据提取",
    "自动填表",
    "工作流自动化",
    "浏览器控制"
  ],
  "files": [
    "src/",
    "bin/",
    "assets/",
    "examples/",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses/",
    "README.md",
    "docs/"
  ]
}
