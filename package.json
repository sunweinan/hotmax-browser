{
  "name": "hotmax-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron src/main.cjs",
    "browser": "node bin/hotmax-browser.js",
    "test": "node --test test/*.test.js",
    "test:browser": "node test/integration.js",
    "check": "prettier --check src bin scripts test examples package.json .github",
    "format": "prettier --write src bin scripts test examples package.json .github",
    "package": "node scripts/package.mjs",
    "release:source": "node scripts/release-source.mjs"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "45.3.2",
    "prettier": "^3.9.10"
  },
  "productName": "Hotmax Browser",
  "description": "A local browser controlled through CLI and JavaScript, without taking over your mouse.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunweinan/hotmax-browser.git"
  },
  "bugs": {
    "url": "https://github.com/sunweinan/hotmax-browser/issues"
  },
  "homepage": "https://github.com/sunweinan/hotmax-browser#readme",
  "bin": {
    "hotmax-browser": "bin/hotmax-browser.js"
  },
  "keywords": [
    "browser",
    "electron",
    "cli",
    "automation",
    "ai-agent"
  ],
  "files": [
    "src/",
    "bin/",
    "assets/",
    "examples/",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses/",
    "README.md",
    "docs/"
  ]
}
